# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database (AWS RDS PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/crm_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis (AWS ElastiCache) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TOKEN_PREFIX=crm:token:
REDIS_SESSION_PREFIX=crm:session:
REDIS_RATE_LIMIT_PREFIX=crm:ratelimit:

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS Cognito
AWS_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
AWS_COGNITO_CLIENT_ID=your-cognito-client-id
AWS_COGNITO_CLIENT_SECRET=your-cognito-client-secret

# AWS SES (Email)
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
AWS_SES_REGION=us-east-1

# AWS Secrets Manager
AWS_SECRETS_MANAGER_REGION=us-east-1

# AWS SNS
AWS_SNS_REGION=us-east-1

# ─── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GCP Pub/Sub
GCP_PUBSUB_TOPIC_AUTH_EVENTS=crm-auth-events
GCP_PUBSUB_TOPIC_USER_EVENTS=crm-user-events

# ─── Apple Sign-In ────────────────────────────────────────────────────────────
APPLE_TEAM_ID=your-apple-team-id
APPLE_CLIENT_ID=com.yourcompany.crm
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# ─── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/your-key-id

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
